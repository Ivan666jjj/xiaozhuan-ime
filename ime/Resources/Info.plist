<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleExecutable</key>
	<string>ShuowenIME</string>
	<key>CFBundleIdentifier</key>
	<string>com.local.inputmethod.ShuowenSeal</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>小焕的小篆输入法</string>
	<key>CFBundleDisplayName</key>
	<string>小焕的小篆输入法</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleIconFile</key>
	<string>ShuowenIME.icns</string>
	<key>CFBundleIconName</key>
	<string>ShuowenIME</string>
	<key>LSMinimumSystemVersion</key>
	<string>10.13</string>
	<!-- 输入法常驻后台、不出现在 Dock / App 切换器。
	     只用 LSUIElement 就够（千问输入法就是 LSUIElement=true + LSBackgroundOnly=false）。
	     ⚠️ 不要再加 LSBackgroundOnly=true：那会把 app 标记成「纯后台进程、不得连接
	     窗口服务器」，输入法需要显示候选窗，会因此加载失败（表现为 TIS 里能枚举、
	     TISSelectInputSource 却返回 paramErr(-50)、切换键里永远轮不到它）。 -->
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- 必须与 CFBundleIdentifier 同形：<bundleID>_Connection。
	     macOS 26+ 的 imklaunchagent 会拒绝其它形式的连接名，
	     导致输入法注册得上、却永远无法被选中（TISSelectInputSource 返回 -50）。 -->
	<key>InputMethodConnectionName</key>
	<string>com.local.inputmethod.ShuowenSeal_Connection</string>
	<key>InputMethodServerControllerClass</key>
	<string>SealInputController</string>
	<key>InputMethodServerDelegateClass</key>
	<string>AppDelegate</string>

	<!-- 输入模式声明。
	     结构照抄系统自带的 AinuIM.app：tsInputModeListKey 必须包在
	     ComponentInputModeDict 底下（放在顶层会被忽略），每个模式必须带
	     TISInputSourceID，并由 tsVisibleInputModeOrderedArrayKey 列出顺序。 -->
	<key>ComponentInputModeDict</key>
	<dict>
		<key>tsInputModeListKey</key>
		<dict>
			<key>com.local.inputmethod.ShuowenSeal.Seal</key>
			<dict>
				<key>TISInputSourceID</key>
				<string>com.local.inputmethod.ShuowenSeal.Seal</string>
				<key>tsInputModeDefaultStateKey</key>
				<true/>
				<key>tsInputModeIsVisibleKey</key>
				<true/>
				<key>tsInputModePrimaryInScriptKey</key>
				<true/>
				<!-- 与微信输入法 / 千问输入法一致：脚本用 smSimpChinese。
				     先前用 smUnicodeScript 且 PrimaryInScript=true，系统解析不出输入
				     模式（TIS 里名字显示成 ID 本身、无法切换、系统设置里也看不到）。 -->
				<key>tsInputModeScriptKey</key>
				<string>smSimpChinese</string>
				<key>tsInputModeMenuIconFileKey</key>
				<string>menu_16.png</string>
				<key>tsInputModePaletteIconFileKey</key>
				<string>menu_32.png</string>
				<key>tsInputModeAlternateMenuIconFileKey</key>
				<string>menu_16.png</string>
				<key>tsInputModeKeyEquivalentKey</key>
				<string></string>
				<key>tsInputModeKeyEquivalentModifiersKey</key>
				<integer>4608</integer>
				<key>TISIconLabels</key>
				<dict>
					<key>CustomIcon</key>
					<string>menu_32.png</string>
				</dict>
			</dict>
		</dict>
		<key>tsVisibleInputModeOrderedArrayKey</key>
		<array>
			<string>com.local.inputmethod.ShuowenSeal.Seal</string>
		</array>
	</dict>

	<key>tsInputMethodCharacterRepertoireKey</key>
	<array>
		<string>Hans</string>
	</array>
	<!-- 与千问输入法一致：顶层还要给输入法一个图标，系统设置里才显示得出来 -->
	<key>tsInputMethodIconFileKey</key>
	<string>shuowen_menu_icon.pdf</string>
</dict>
</plist>
